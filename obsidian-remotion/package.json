{
  "name": "obsidian-remotion",
  "version": "1.0.0",
  "description": "An Obsidian plugin that turns Markdown notes into live, type-checked Remotion previews.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.js",
    "build": "NODE_ENV=production node esbuild.config.js",
    "clean": "rm -rf main.js esbuild.wasm",
    "watch": "node esbuild.config.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "remotion",
    "video",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "remotion-md": "*"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "*",
    "@codemirror/lint": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.19.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.20.0",
    "jsdom": "^28.1.0",
    "obsidian": "^1.11.0",
    "tslib": "^2.8.1",
    "typescript": "^4.0.0",
    "vitest": "^4.0.18"
  }
}